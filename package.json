{
  "name": "diagiot",
  "version": "1.0.0",
  "description": "DiagIoT — Agentic Drift Detection Platform. Web UI + Backend API + CLI.",
  "main": "src/server/index.js",
  "bin": {
    "diagiot": "./src/cli/diagiot.js"
  },
  "scripts": {
    "start":     "node src/server/index.js",
    "dev":       "node --watch src/server/index.js",
    "cli":       "node src/cli/diagiot.js",
    "repl":      "node src/cli/diagiot.js interactive"
  },
  "keywords": ["iot", "drift", "embedded", "firmware", "agentic", "monitoring", "cli"],
  "author": "DiagIoT Team",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "express":       "^4.19.2",
    "ws":            "^8.17.1",
    "axios":         "^1.7.2",
    "node-fetch":    "^3.3.2",
    "dotenv":        "^16.4.5",
    "cors":          "^2.8.5",
    "node-cron":     "^3.0.3",
    "serialport":    "^12.0.0",
    "execa":         "^9.3.0",
    "fs-extra":      "^11.2.0",
    "chalk":         "^5.3.0",
    "inquirer":      "^10.1.8",
    "multer":        "^1.4.5-lts.1",
    "jsonwebtoken":  "^9.0.2"
  }
}
