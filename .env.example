# DiagIoT Environment Configuration
# Copy to .env and fill in your real values

# ── Bob AI Agent ───────────────────────────────────────────────────────────────
# IBM Bob platform API key — enables autonomous root-cause analysis, KB synthesis,
# firmware diff interpretation, and predictive drift AI features.
# Get your key from: https://platform.ibm.com/bob
BOB_AGENT_API_KEY=bob_prod_bob-apikey_2omRpZbWJ7w25CLcYTWHFC4SqvFZSuaEf2D6tVJU6Y6hsuktjVoiSA8QLbhSyRCChnyyGKCvCkjdDVirXUmNsUyZ_6rastWizvyVFkR9uvBDbG6yadKQSokisaRPH552vgapG
BOB_AGENT_BASE_URL=https://api.ibm.com/bob/v1

# ── Supabase Authentication ────────────────────────────────────────────────────
# Required for real auth. Get these from https://app.supabase.com → Settings → API
SUPABASE_URL=https://dntfhknlmtbnitufzruj.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRudGZoa25sbXRibml0dWZ6cnVqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMDgyNDMsImV4cCI6MjEwMzU4NDI0M30.JhY_Tc3bQPEJ--XNXqfg_eYSbNpVO5mgEyUmDGi8kLE
# Optional: JWT secret for server-side token verification (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Server
PORT=3000
HOST=localhost

# ── GitHub OAuth (Supabase sign-in) ───────────────────────────────────────────
# Add these in Supabase Dashboard → Authentication → Providers → GitHub
# GitHub OAuth App → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=Ov23liISdmkuEsQGkTNZ
GITHUB_CLIENT_SECRET=32c73860b57d83ca8803c80ee4c4f2e8677e1194

# ── GitHub Webhooks (CI/CD integration) ───────────────────────────────────────
# Settings → Webhooks → Payload URL: https://diag-io-t.vercel.app/api/integrations/github/webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Arduino / Serial
ARDUINO_CLI_PATH=arduino-cli
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=115200

# Jenkins CI
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_api_token

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# VS Code / PlatformIO — extension connects back via this server
# No extra config needed; extension reads DIAGIOT_SERVER from settings

# Keil / STM32CubeIDE — post-build hook endpoint
# Configure post-build: curl -X POST http://localhost:3000/api/integrations/keil/artifact -F file=@output.elf

# Drift thresholds (0.00 - 1.00)
DRIFT_THRESHOLD_WARN=0.40
DRIFT_THRESHOLD_BLOCK=0.70
